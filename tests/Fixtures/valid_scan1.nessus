<?xml version="1.0" encoding="UTF-8"?>
<NessusClientData_v2>
  <Policy>
    <policyName>Basic Network Scan</policyName>
    <Preferences>
      <ServerPreferences>
        <preference>
          <name>max_hosts</name>
          <value>30</value>
        </preference>
      </ServerPreferences>
    </Preferences>
  </Policy>
  <Report name="Corporate Scan - Segment A" xmlns:cm="http://www.nessus.org/cm">
    <ReportHost name="192.168.1.10">
      <HostProperties>
        <tag name="HOST_START">Thu Jan 01 10:00:00 2026</tag>
        <tag name="HOST_END">Thu Jan 01 10:15:00 2026</tag>
        <tag name="host-ip">192.168.1.10</tag>
        <tag name="host-fqdn">server1.corp.local</tag>
        <tag name="netbios-name">SERVER1</tag>
        <tag name="operating-system">Linux Kernel 5.15</tag>
      </HostProperties>
      <ReportItem port="445" svc_name="cifs" protocol="tcp" severity="3" pluginID="10001" pluginName="SMB Vulnerability" pluginFamily="Windows">
        <description>SMB vulnerability detected on target host.</description>
        <risk_factor>High</risk_factor>
        <solution>Apply vendor patch.</solution>
        <synopsis>An SMB service is vulnerable.</synopsis>
        <plugin_output>SMB vulnerability detected on port 445.</plugin_output>
        <cve>CVE-2020-0001</cve>
        <cvss_base_score>7.5</cvss_base_score>
      </ReportItem>
      <ReportItem port="80" svc_name="http" protocol="tcp" severity="2" pluginID="10002" pluginName="Apache Outdated" pluginFamily="Web Servers">
        <description>Apache HTTP Server is outdated.</description>
        <risk_factor>Medium</risk_factor>
        <solution>Upgrade to current version.</solution>
        <synopsis>Web server is outdated.</synopsis>
        <plugin_output>Apache 2.4.41 detected on port 80.</plugin_output>
        <cve>CVE-2021-0002</cve>
        <cvss_base_score>5.3</cvss_base_score>
      </ReportItem>
    </ReportHost>
    <ReportHost name="192.168.1.20">
      <HostProperties>
        <tag name="HOST_START">Thu Jan 01 10:05:00 2026</tag>
        <tag name="HOST_END">Thu Jan 01 10:20:00 2026</tag>
        <tag name="host-ip">192.168.1.20</tag>
        <tag name="host-fqdn">gateway.corp.local</tag>
      </HostProperties>
      <ReportItem port="22" svc_name="ssh" protocol="tcp" severity="1" pluginID="10003" pluginName="SSH Weak Ciphers" pluginFamily="General">
        <description>SSH supports weak CBC ciphers.</description>
        <risk_factor>Low</risk_factor>
        <solution>Disable CBC ciphers in sshd_config.</solution>
        <synopsis>SSH ciphers need hardening.</synopsis>
        <plugin_output>Weak ciphers supported: aes128-cbc</plugin_output>
      </ReportItem>
    </ReportHost>
  </Report>
</NessusClientData_v2>
